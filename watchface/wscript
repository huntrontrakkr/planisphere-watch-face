#
# The Pebble SDK's build, for both watches, with the face's own flags. The app's binary is main.c alone: the renderer
# (src/c/plan_*.c) is built by tools/build_blob.py into a code resource, which main.c loads at start.
#
import os
import shutil
import subprocess
import sys

top = '.'
out = 'build'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')
    # the renderer's code first, with the compiler the SDK builds the app with: the resources are packed from it
    cc = ctx.all_envs[ctx.env.TARGET_PLATFORMS[0]].CC
    cc = shutil.which(cc[0] if isinstance(cc, list) else cc) or ''
    subprocess.check_call([sys.executable, os.path.join(ctx.path.abspath(), '..', 'tools', 'build_blob.py')] +
                          (['--cc', cc] if cc else []))
    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        # the same arithmetic as the host and the settings page's preview: no fused multiply-adds
        if '-ffp-contract=off' not in ctx.env.CFLAGS:
            if os.environ.get('PLAN_PROFILE'):
                # for tools/emulator.py profile: every function its own, to count where the time goes
                ctx.env.append_value('CFLAGS', ['-ffp-contract=off', '-fno-inline'])
            else:
                ctx.env.append_value('CFLAGS', ['-ffp-contract=off', '-flto'])
                # link-time optimisation for size; nothing references the SDK's app header, so it is kept by name
                ctx.env.append_value('LINKFLAGS', ['-flto', '-Os', '-ffp-contract=off', '-Wl,-u,__pbl_app_info'])
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=[ctx.path.find_node('src/c/main.c')], target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env
    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js', 'src/pkjs/**/*.json']),
                   js_entry_file='src/pkjs/index.js')
